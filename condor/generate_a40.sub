# Generate showers on HTCondor A40 slots (GPU compute capability 8.x). Activate the Python environment, then from the
# repository folder:
#   mkdir -p /scratch/$USER/showerlm_logs
#   condor_submit condor/generate_a40.sub                                 (4 jobs x 256 showers)
#   condor_submit condor/generate_a40.sub jobs=2 n=64 seed0=100 outdir=/path/to/new/folder
# Defaults: jobs=4, n=256 showers per job, seed0=0, outdir=<repository>/showers_a40, logdir=/scratch/<user>/showerlm_logs
# (condor logs may not be written to /data/user).  Job k writes <outdir>/job_k with seed seed0 + k.  8 GB is enough
# (2-5 GB used).  Jobs read and write the shared file system directly.

repo   = $ENV(PWD)
logs   = $(logdir:/scratch/$ENV(USER)/showerlm_logs)
gpu    = a40
cap_lo = 8.0
cap_hi = 9.0

universe       = vanilla
executable     = $(repo)/condor/run_gpu.sh
arguments      = "$(repo) $(n:256) $(outdir:$(repo)/showers_a40)/job_$(Process) $(Process) $(seed0:0) $(gpu)"
getenv         = True
environment    = "OMP_NUM_THREADS=4"
request_cpus   = 4
request_gpus   = 1
request_memory = 8GB
request_disk   = 2GB
requirements   = (GPUs_Capability >= $(cap_lo)) && (GPUs_Capability < $(cap_hi))
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
output = $(logs)/gen_a40.$(Cluster).$(Process).out
error  = $(logs)/gen_a40.$(Cluster).$(Process).err
log    = $(logs)/gen_a40.$(Cluster).log
queue $(jobs:4)
